# Dillanci - Enterprise Procurement Platform
# Environment Configuration Template
# Copy this file to .env and customize for your environment

# =============================================================================
# Database Configuration
# =============================================================================
POSTGRES_DB=dillanci
POSTGRES_USER=dillanci
POSTGRES_PASSWORD=your_secure_password_here
POSTGRES_PORT=5432

# =============================================================================
# Redis Configuration
# =============================================================================
REDIS_PORT=6379

# =============================================================================
# Django Backend Configuration
# =============================================================================
DEBUG=True
SECRET_KEY=your-secret-key-change-in-production-minimum-50-characters

# Comma-separated list of allowed hosts
ALLOWED_HOSTS=localhost,127.0.0.1,backend

# Comma-separated list of allowed CORS origins
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:80,http://frontend

# Django settings module
DJANGO_SETTINGS_MODULE=config.settings.development

# Backend port
BACKEND_PORT=8000

# =============================================================================
# Frontend Configuration
# =============================================================================
FRONTEND_PORT=3000

# Set to 'true' to use mock data (no backend required)
VITE_MOCK_API=false

# =============================================================================
# Optional: Email Configuration (for notifications)
# =============================================================================
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=your-email@example.com
# EMAIL_HOST_PASSWORD=your-email-password

# =============================================================================
# Optional: AWS S3 Configuration (for document storage)
# =============================================================================
# AWS_ACCESS_KEY_ID=your-access-key
# AWS_SECRET_ACCESS_KEY=your-secret-key
# AWS_STORAGE_BUCKET_NAME=your-bucket-name
# AWS_S3_REGION_NAME=us-east-1
